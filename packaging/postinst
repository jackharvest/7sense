#!/bin/sh
set -e

# Register the apt repository so future updates arrive automatically.
# The GPG key is bundled in the package -- no internet needed here.
if [ ! -f /etc/apt/keyrings/7sense.gpg ]; then
    mkdir -p /etc/apt/keyrings
    gpg --dearmor \
        < /usr/share/7sense/7sense-apt.gpg.asc \
        > /etc/apt/keyrings/7sense.gpg 2>/dev/null || true
fi
if [ ! -f /etc/apt/sources.list.d/7sense.list ]; then
    echo "deb [signed-by=/etc/apt/keyrings/7sense.gpg arch=amd64] https://jackharvest.github.io/7sense stable main" \
        > /etc/apt/sources.list.d/7sense.list
fi

# Copy icon into the AppStream swcatalog icon cache so Discover renders it.
# The stock: type requires a system icon theme lookup which doesn't work for
# third-party origins; cached: type reads directly from this path instead.
mkdir -p /usr/share/swcatalog/icons/jackharvest-7sense/256x256
cp /usr/share/icons/hicolor/256x256/apps/7sense.png \
   /usr/share/swcatalog/icons/jackharvest-7sense/256x256/7sense.png \
   2>/dev/null || true

# Write a DEP-11 swcatalog entry so Discover can link this component to the
# installed package. On AppStream 1.x (Ubuntu 25.04+), apt does not populate
# /var/lib/swcatalog from third-party repos -- only Ubuntu's own infra does.
# Writing directly from postinst (which runs as root) is the only reliable path.
if [ -d /var/lib/swcatalog/yaml ]; then
    gzip -9 \
        > /var/lib/swcatalog/yaml/jackharvest.github.io_7sense_dists_stable_main_dep11_Components-amd64.yml.gz \
        2>/dev/null << 'DEPYAML' || true
---
File: DEP-11
Version: '1.0'
Origin: jackharvest-7sense
---
Type: desktop-application
ID: io.github.jackharvest.7sense
Package: 7sense
Name:
  C: 7Sense
Summary:
  C: Real extraction progress for Linux archive tools
Description:
  C: >-
    7Sense sits in your system tray and shows real extraction progress --
    actual percentages and time remaining -- for 7-Zip, tar, zip, and RAR.
    No changes to your existing tools required. Around 4 MB RAM at idle.
DeveloperName:
  C: jackharvest
ProjectLicense: MIT
Url:
  homepage: https://github.com/jackharvest/7sense
Icon:
  cached:
  - name: 7sense.png
    width: 256
    height: 256
Categories:
- Utility
DEPYAML
fi

if command -v update-icon-caches >/dev/null 2>&1; then
    update-icon-caches /usr/share/icons/hicolor
fi
if command -v appstreamcli >/dev/null 2>&1; then
    appstreamcli refresh --force >/dev/null 2>&1 || true
fi
